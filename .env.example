# Local settings. Copy to .env:   cp .env.example .env
# .env is ignored by git. Nothing here is a secret.
# Full list of settings: app/config.py and docs/implementation-guide.md section 4.

SLM_ENV=local
SLM_LOG_LEVEL=INFO

# Uploaded documents and results are stored as files under ./data/jobs/<job_id>/.
SLM_DATA_DIR=./data

# The AI model, running in Ollama on this machine (see docs/local-setup.md section 3).
# Use SLM_MODEL_PROVIDER=fake to try the API without a model (every field comes back empty).
SLM_MODEL_PROVIDER=openai_compatible
SLM_MODEL_BASE_URL=http://localhost:11434/v1
SLM_MODEL_NAME=qwen3-vl:4b
SLM_MODEL_TIMEOUT_S=900
